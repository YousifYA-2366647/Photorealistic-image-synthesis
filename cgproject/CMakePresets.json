{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_EMBREE": "ON",
        "USE_ASSIMP": "ON",
        "USE_OPENMP": "OFF"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-cgproject",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio + vcpkg)",
      "inherits": "windows-base"
    },
    {
      "name": "windows-debug",
      "displayName": "Windows, debuggable (no OpenMP, Embree still on)",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_OPENMP": "OFF"
      }
    },
    {
      "name": "windows-embree-sdk",
      "displayName": "Windows, using a prebuilt Embree SDK from third_party/ (fastest setup)",
      "inherits": "windows-base",
      "cacheVariables": {
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (system packages)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-vcpkg",
      "displayName": "Linux (vcpkg, if system packages are too old)",
      "inherits": "vcpkg",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux, debuggable",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_OPENMP": "OFF"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Homebrew)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "no-embree",
      "displayName": "Reference build: srtk uniform grid instead of Embree",
      "inherits": "base",
      "cacheVariables": {
        "USE_EMBREE": "OFF",
        "USE_OPENMP": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-embree-sdk",
      "configurePreset": "windows-embree-sdk",
      "configuration": "Release"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-vcpkg",
      "configurePreset": "linux-vcpkg"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "no-embree",
      "configurePreset": "no-embree"
    }
  ]
}
